<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Shared dependencies come from services/pom.xml; plugins and versions from the root POM. -->
  <parent>
    <groupId>se.rainmaker</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>matching-ranking</artifactId>
  <name>S7 Matching and Ranking</name>
  <description>Suggests offers for green articles, ranked by relevance; CPC only breaks ties.</description>

  <!-- Its own PostgreSQL database with Flyway migrations (#155, architecture D16). -->
  <dependencies>
    <!-- Connection pool (HikariCP), JdbcClient and transactions. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Flyway itself, not Boot's starter: each module runs its own migrations (see the
         module's database configuration), because an app holds several databases. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- S6's api: the ArticleClassified event and the Topic and Zone types (#149). Same app (G2),
         so only the api package; the app's ArchUnit test checks it. -->
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>content-intent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Retries with back-off on the call to G3's offers API (CLAUDE.md, "External calls");
         managed in the root POM, as in content-intent and the collector. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
    </dependency>

    <!-- A fake G3 in the tests: external APIs are never called from tests (CLAUDE.md). -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
