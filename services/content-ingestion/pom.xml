<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Shared dependencies come from services/pom.xml; plugins and versions from the root POM. -->
  <parent>
    <groupId>se.rainmaker</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>content-ingestion</artifactId>
  <name>S5 Content Ingestion</name>
  <description>Reads new and edited articles from the publisher's feed (in the demo, the test site's RSS feed) and stores them.</description>

  <properties>
    <!-- Domain logic (#147): the 80 % line-coverage gate applies (CLAUDE.md, "Testing"). -->
    <jacoco.check.skip>false</jacoco.check.skip>
  </properties>

  <!-- Its own PostgreSQL database with Flyway migrations (#155, architecture D16). -->
  <dependencies>
    <!-- Connection pool (HikariCP), JdbcClient and transactions. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Flyway itself, not Boot's starter: each module runs its own migrations (see the
         module's database configuration), because an app holds several databases. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The body text of an article page (#147): the RSS feed only has the lead. -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
    </dependency>

    <!-- The publisher's site is faked with WireMock, the database is a real PostgreSQL
         (CLAUDE.md, "Testing"). -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
