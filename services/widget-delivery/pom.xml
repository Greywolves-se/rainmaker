<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Shared dependencies come from services/pom.xml; plugins and versions from the root POM. -->
  <parent>
    <groupId>se.rainmaker</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>widget-delivery</artifactId>
  <name>S1 Widget Delivery</name>
  <description>Gives rainmaker.js the approved links for an article.</description>

  <dependencies>
    <!-- S2's signed click links (contract 7.5), which the widget API gives instead of the offer's
         address. Only its api package may be used (CLAUDE.md, "Architecture rules"). -->
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>tracking-click</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Retries with back-off and a circuit breaker on the call to G3's approved links API
         (CLAUDE.md, "External calls"; contract 7). Both managed in the root POM. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>

    <!-- A fake G3 in the tests: external APIs are never called from tests (CLAUDE.md). -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
