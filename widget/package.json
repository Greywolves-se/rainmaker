{
  "name": "rainmaker-widget",
  "version": "0.1.0",
  "private": true,
  "description": "rainmaker.js: the script on the publisher's page that shows the approved links on headline hover.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "lint": "eslint src scripts vite.config.ts --ext .ts,.mjs",
    "fix": "eslint src scripts vite.config.ts --ext .ts,.mjs --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "8.57.1",
    "gts": "5.3.1",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
