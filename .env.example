# Optional settings for the local demo stack (docker-compose.yml, #146).
# Copy to .env (git-ignored) and change what you need. Never put keys or passwords here:
# AWS access comes from your SSO login, not from this file.

# fake (default, no AWS needed) or bedrock. For bedrock, start with docker-compose.bedrock.yml.
RAINMAKER_CLASSIFIER_MODE=fake

# The zone the fake classifier gives EVERY article. red (default) fails closed: no panel anywhere.
# green shows panels for local work on matching or the widget, but then the red test articles
# (the robbery, the fatal accident) get a panel too. Never use green for the demo.
RAINMAKER_FAKE_ZONE=red

# Your AWS SSO profile, only for docker-compose.bedrock.yml (aws sso login --profile <name>).
AWS_PROFILE=

# Where your AWS config is, if not in ~/.aws.
# AWS_CONFIG_DIR=C:/Users/<you>/.aws

# Where the test site loads rainmaker.js from (default: G1).
# RAINMAKER_SCRIPT_URL=http://localhost:8081/widget/rainmaker.js
