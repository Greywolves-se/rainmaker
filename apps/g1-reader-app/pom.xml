<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Formatting, Checkstyle, JaCoCo and the Java version come from the root POM. -->
  <parent>
    <groupId>se.rainmaker</groupId>
    <artifactId>rainmaker-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>g1-reader-app</artifactId>
  <name>G1 Reader and clicks</name>
  <description>Serves rainmaker.js its links and handles clicks. The hot path: it must stay fast and fail open.</description>

  <dependencies>
    <!-- The services this app assembles (#145). An app depends on services, never the other way. -->
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>widget-delivery</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>tracking-click</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Metrics and a trace id in every log line (#193; agreed on #193 with #188). Versions come
         from Spring Boot's dependency management. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Spring Boot 4's tracing auto-configuration with the OpenTelemetry bridge: a trace id per
         request in the MDC. No exporter: nothing is sent anywhere until the AWS work. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JUnit 5, AssertJ, Mockito and MockMvc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A real PostgreSQL in the tests (CLAUDE.md, "Testing"): the app starts against it and
         every module's Flyway migrations run, as locally. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Module boundaries (README.md, "Code quality"). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Builds the runnable jar (target/g1-reader-app-0.1.0-SNAPSHOT.jar); see README.md, "Run". -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
