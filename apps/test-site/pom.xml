<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rainmaker test site (Vintrabladet) - Java 21 + Spring Boot 3, built with Maven.

  Everyday commands (use the Maven Wrapper, no Maven installation needed):
    ./mvnw spring-boot:run      start the site on http://localhost:3000
    ./mvnw verify               format check, style check and all tests
    ./mvnw spotless:apply       format all Java code (google-java-format)
  On Windows PowerShell/cmd use .\mvnw.cmd instead of ./mvnw.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Latest 3.x patch release (the project standard is Spring Boot 3.x). -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>nu.rainmaker</groupId>
  <artifactId>test-site</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Rainmaker test site</name>
  <description>Fictional Swedish news site (Vintrabladet) used to develop and test Rainmaker. All content is made up.</description>

  <properties>
    <java.version>21</java.version>
    <spotless.version>3.10.4</spotless.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <checkstyle.version>14.3.0</checkstyle.version>
  </properties>

  <dependencies>
    <!-- Web server (embedded Tomcat) and Spring MVC. Includes Jackson for JSON. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Server-side HTML templates. Escapes text automatically (protects against XSS). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- Tests: JUnit 5, AssertJ, Mockito and MockMvc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Google Java Style formatting. "verify" fails if code is not formatted;
           fix it with ./mvnw spotless:apply. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <!-- Spotless picks a google-java-format version it is tested with. -->
            <googleJavaFormat/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Checkstyle with Google's rules. Any finding fails the build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>google_checks.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <violationSeverity>warning</violationSeverity>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
