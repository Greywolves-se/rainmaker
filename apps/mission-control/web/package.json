{
  "name": "mission-control-web",
  "version": "0.1.0",
  "private": true,
  "description": "Mission Control dashboard (React, TypeScript, Vite, i18n).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e playwright.config.ts --ext .ts,.tsx",
    "fix": "eslint src e2e playwright.config.ts --ext .ts,.tsx --fix",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "i18next": "23.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.3",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "gts": "5.3.1",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
