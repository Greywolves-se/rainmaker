<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>se.rainmaker</groupId>
    <artifactId>mission-control</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>navigator-api</artifactId>
  <name>Mission Control Navigator API</name>
  <description>Answers live "Ask Navigator" questions for the dashboard (#117, ADR 0003). Plain Java, no Spring; runs as an AWS Lambda.</description>

  <dependencies>
    <!-- Hides names before text goes to OpenAI (ADR 0002, 0003); our own module from #115. -->
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>anonymizer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- JSON for the OpenAI API (Jackson 3, the same as the collector). -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- At most one retry towards OpenAI (ADR 0003); already used by the collector (#90). -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Contract test against contract/navigator-ask.schema.json; already used by the collector. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A fake OpenAI in tests; never the real API (CLAUDE.md). -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
