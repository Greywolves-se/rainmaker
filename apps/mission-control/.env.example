# Copy to .env (git-ignored) and fill in. Never commit .env.

# Fine-grained GitHub token with read-only access to Greywolves-se/rainmaker
# (Issues, Pull requests, Actions, Metadata). Used by the collector's GitHub sources.
MC_GITHUB_TOKEN=

# Host port for the dashboard.
MC_WEB_PORT=8080

# Optional, for the Google Drive and OpenAI sources (#112, #113, #115). Get your own key; never
# reuse the staging secrets. Without them, those sources (once built) report "error" and the rest
# still works.
OPENAI_API_KEY=
# The service account's JSON key on one line. Keep the key file outside the repository.
MC_GOOGLE_SERVICE_ACCOUNT_JSON=
