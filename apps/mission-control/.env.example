# Copy to .env (git-ignored) and fill in. Never commit .env.

# Fine-grained GitHub token with read-only access to Greywolves-se/rainmaker
# (Issues, Pull requests, Actions, Metadata). Used by the collector's GitHub sources.
MC_GITHUB_TOKEN=

# Google Drive (#113): the read-only service account's JSON key, on one line (the whole file as
# text). Optional: without it, a project with a Drive folder shows the Drive source as an error.
MC_GOOGLE_DRIVE_CREDENTIALS=

# Host port for the dashboard.
MC_WEB_PORT=8080

# Optional, for the OpenAI source (#112, #115). Use your own key; never reuse the staging one.
# Without it, that source (once built) reports "error" and the rest still works.
# From #120, Google Drive needs no key: sign in with
# gcloud auth application-default login --impersonate-service-account=mission-control-drive-reader@mission-control-512109.iam.gserviceaccount.com
OPENAI_API_KEY=
