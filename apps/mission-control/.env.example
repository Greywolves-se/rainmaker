# Copy to .env (git-ignored) and fill in. Never commit .env.

# Fine-grained GitHub token with read-only access to Greywolves-se/rainmaker
# (Issues, Pull requests, Actions, Metadata). Used by the collector's GitHub sources.
MC_GITHUB_TOKEN=

# Host port for the dashboard.
MC_WEB_PORT=8080

# Optional, for the OpenAI part (#112, #115). Use your own key; never reuse the staging one.
# Without it, that part (once built) reports "error" and the rest still works.
OPENAI_API_KEY=
# Switches the Navigator AI text on (#115); it stays off without this, even with a key.
MC_NAVIGATOR_ENABLED=false

# Google Drive (#113) needs no key (#120): it uses Google's standard login with the read-only
# service account impersonated (a plain gcloud login is refused):
#   gcloud auth application-default login --impersonate-service-account=mission-control-drive-reader@mission-control-512109.iam.gserviceaccount.com
# See the README, "Google Drive", for mounting the login file into the collector container.
