<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>se.rainmaker</groupId>
    <artifactId>mission-control</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>collector</artifactId>
  <name>Mission Control collector</name>
  <description>Command-line app that collects project data and writes the Mission Control snapshot.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- Writes the snapshot as JSON (Jackson 3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- Reads the hand-maintained data files in apps/mission-control/data (#15). -->
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!-- Checks every source's data against the snapshot schema before it is written (#11). -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The contract schema is packed into the jar (classpath: contract/snapshot.schema.json),
           so the collector validates against the same file as the tests. -->
      <resource>
        <directory>../contract</directory>
        <includes>
          <include>snapshot.schema.json</include>
        </includes>
        <targetPath>contract</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- Packages an executable jar (java -jar), used by collector/Dockerfile. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
