<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Formatting, Checkstyle, JaCoCo and the Java version come from the root POM. -->
  <parent>
    <groupId>se.rainmaker</groupId>
    <artifactId>rainmaker-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>g2-content-app</artifactId>
  <name>G2 Content and intelligence</name>
  <description>Reads articles, classifies them with Claude on Amazon Bedrock and suggests offers.</description>

  <dependencies>
    <!-- The services this app assembles (#145). An app depends on services, never the other way. -->
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>content-ingestion</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>content-intent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.rainmaker</groupId>
      <artifactId>matching-ranking</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- JUnit 5, AssertJ, Mockito and MockMvc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A real PostgreSQL in the tests (CLAUDE.md, "Testing"): the app starts against it and
         every module's Flyway migrations run, as locally. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A fake G3 offers API for matching's tests (#149): never the real G3 (CLAUDE.md). -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Module boundaries (README.md, "Code quality"). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Builds the runnable jar (target/g2-content-app-0.1.0-SNAPSHOT.jar); see README.md, "Run". -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
