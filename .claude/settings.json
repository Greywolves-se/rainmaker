{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push --set-upstream origin feature/*)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(git push)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push * develop)",
      "Bash(git push *:develop)",
      "Bash(git push * release/*)",
      "Bash(git push *:release/*)"
    ]
  }
}
