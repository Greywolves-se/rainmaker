# Build output
target/
dist/
build/
coverage/
# CDK synth output (infra/)
cdk.out/

# Dependencies
node_modules/

# Mission Control generated snapshot and reports (contain internal data, never commit)
apps/mission-control/out/

# Secrets and local settings
.env
.env.*
!.env.example
# Personal Docker Compose overrides, e.g. the local Google login mount (#120)
docker-compose.override.yml
*.pem

# IDEs and OS
.idea/
*.iml
# Folder ignored with /* (not /) so single files can be shared again.
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log

# Short-lived Google credentials written by google-github-actions/auth (#112); never commit.
gha-creds-*.json
