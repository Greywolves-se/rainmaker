<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>se.rainmaker</groupId>
  <artifactId>rainmaker-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Rainmaker</name>
  <description>Contextual performance marketplace for digital news publishers.</description>

  <properties>
    <java.version>21</java.version>

    <!-- Code-quality tools (#39). Versions live here only; modules never repeat them. -->
    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
    <!-- 1.37.0 crashes inside spotless-maven-plugin 3.10.4; bump both together and test. -->
    <google-java-format.version>1.36.0</google-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>14.3.0</checkstyle.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <archunit.version>1.5.1</archunit.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <!-- Service-account login for the Google Drive source (#113): only the access token; Drive
         calls go through our own RestClient. -->
    <google-auth-library.version>1.54.0</google-auth-library.version>
    <!-- 4.x is still beta. The standalone jar bundles its own Jetty, so it cannot clash with
         the libraries Spring Boot brings. -->
    <wiremock.version>3.13.2</wiremock.version>
    <!-- Reads the body text from a publisher's article page (#147). -->
    <jsoup.version>1.23.2</jsoup.version>
    <!-- AWS SDK for Java v2 (#148: Bedrock Runtime). Spring Boot does not manage it; the BOM
         below keeps every AWS module on the same version. -->
    <aws-sdk.version>2.55.12</aws-sdk.version>

    <!-- AWS CDK for the infra/ module (#61). -->
    <aws-cdk-lib.version>2.273.0</aws-cdk-lib.version>
    <constructs.version>10.8.1</constructs.version>
    <!-- Runs the CDK app (infra/cdk.json); Spring Boot does not manage this plugin. -->
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>

    <!-- Coverage gate, off by default. A module switches it on for its domain code with
         <jacoco.check.skip>false</jacoco.check.skip> and, optionally, a package pattern in
         <jacoco.check.packages>, e.g. se.rainmaker.clearinghouse.domain*. -->
    <jacoco.check.skip>true</jacoco.check.skip>
    <jacoco.check.packages>*</jacoco.check.packages>
    <jacoco.check.minimum-line-coverage>0.80</jacoco.check.minimum-line-coverage>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Versions of all AWS SDK v2 modules, e.g. bedrockruntime in content-intent (#148). -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Architecture tests (module boundaries). See README.md, "Code quality". -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- Validation against JSON Schemas (e.g. the Mission Control snapshot, #10, #11).
           Uses Jackson 3, like Spring Boot 4. No scope here: modules choose test or runtime. -->
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <!-- Retries with back-off for calls to external systems (CLAUDE.md, "Architecture rules"). -->
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-retry</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.auth</groupId>
        <artifactId>google-auth-library-oauth2-http</artifactId>
        <version>${google-auth-library.version}</version>
      </dependency>
      <!-- External APIs are mocked with WireMock in tests, never called (CLAUDE.md, "Testing"). -->
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- HTML parsing for article pages in content ingestion (#147). -->
      <dependency>
        <groupId>org.jsoup</groupId>
        <artifactId>jsoup</artifactId>
        <version>${jsoup.version}</version>
      </dependency>
      <!-- AWS CDK v2 for the infra/ module (#61). -->
      <dependency>
        <groupId>software.amazon.awscdk</groupId>
        <artifactId>aws-cdk-lib</artifactId>
        <version>${aws-cdk-lib.version}</version>
      </dependency>
      <dependency>
        <groupId>software.constructs</groupId>
        <artifactId>constructs</artifactId>
        <version>${constructs.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Maven modules are listed here as they are added. The services are grouped by
       services/pom.xml; the apps G1-G3 assemble them (#155). G4 comes later. -->
  <modules>
    <module>apps/mission-control</module>
    <module>services</module>
    <module>apps/g1-reader-app</module>
    <module>apps/g2-content-app</module>
    <module>apps/g3-publisher-app</module>
    <module>test-site</module>
    <module>infra</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!-- Code targets Java 21 (java.version above); any newer JDK can compile it. -->
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>Rainmaker needs JDK 21 or newer.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                  <message>Use the Maven Wrapper (./mvnw) or Maven 3.9 or newer.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Formatting: google-java-format. `verify` fails on unformatted code;
           `./mvnw spotless:apply` fixes it. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>check-formatting</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Style rules that formatting cannot fix (naming, Javadoc, imports ...).
           google_checks.xml reports everything as warnings, so the build fails on warnings. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>google_checks.xml</configLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <violationSeverity>warning</violationSeverity>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <id>check-style</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Test coverage: a report for every module (target/site/jacoco) and the opt-in
           gate configured in the properties above. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-coverage-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>${jacoco.check.packages}</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.check.minimum-line-coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
