<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>se.rainmaker</groupId>
  <artifactId>rainmaker-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Rainmaker</name>
  <description>Contextual performance marketplace for digital news publishers.</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <!-- Maven modules are listed here as they are added. -->
  <!-- Services (services/*) and apps G1–G4 (apps/g1-*-app ...) come later. -->
  <modules>
    <module>apps/mission-control</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!-- Code targets Java 21 (java.version above); any newer JDK can compile it. -->
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>Rainmaker needs JDK 21 or newer.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                  <message>Use the Maven Wrapper (./mvnw) or Maven 3.9 or newer.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
