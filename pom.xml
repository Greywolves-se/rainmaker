<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>se.rainmaker</groupId>
  <artifactId>rainmaker-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Rainmaker</name>
  <description>Contextual performance marketplace for digital news publishers.</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <!-- Logical services (S1–S10): one module each, see architecture v0.5 section 5.1. -->
  <!-- Deployable apps (G1–G4): assemble the services, see section 5.2. -->
  <!-- Mission Control (apps/mission-control) is added as a module in issue #7. -->
  <modules>
    <module>services/widget-delivery</module>
    <module>services/tracking-click</module>
    <module>services/publisher-control</module>
    <module>services/advertiser-marketplace</module>
    <module>services/content-ingestion</module>
    <module>services/content-intent</module>
    <module>services/matching-ranking</module>
    <module>services/inventory-integration</module>
    <module>services/analytics-qti</module>
    <module>services/clearing-house</module>
    <module>apps/g1-reader-app</module>
    <module>apps/g2-content-app</module>
    <module>apps/g3-publisher-app</module>
    <module>apps/g4-money-app</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-java-21</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>Rainmaker needs JDK 21 or newer.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
