# The stack's settings for the end-to-end test (#154), used instead of .env:
#   docker compose --env-file rainmaker-e2e/e2e.env up --build -d
# Only for the test, never for the demo.

# The fake classifier, red for every article (fails closed) ...
RAINMAKER_CLASSIFIER_MODE=fake
RAINMAKER_FAKE_ZONE=red
# ... except headlines with this marker, which are green. tests/support/stack.ts uses the same one.
RAINMAKER_FAKE_GREEN_MARKER=[e2e-green]

# G2 reads the feed every 5 s instead of every minute, so a new article arrives in seconds.
RAINMAKER_FEED_POLL_INTERVAL=5s

# The widget's qualified reading: 2 s instead of 60 s, once #220 replaces the hover.
RAINMAKER_QUALIFIED_READING_SECONDS=2
